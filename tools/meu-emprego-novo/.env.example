# Pessoa ativa (dev_procurando | dev_procurando | ...) — usada quando --person não é passado na CLI
PERSON=dev_procurando

# Provedor de LLM ativo (openai | anthropic | gemini | grok | bedrock) — padrão: openai
LLM_PROVIDER=bedrock

# Máximo de revisões extras até a nota 8.5 (cada uma consome tokens; 0 só avalia)
RESUME_MAX_REVISIONS=3

# Bedrock: credenciais no perfil AWS CLI, nunca neste arquivo.
AWS_PROFILE=mid-life-agent
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1
BEDROCK_FALLBACK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_EXTRACTION_MODEL_ID=deepseek.v3.2
BEDROCK_MAX_TOKENS=16384

# ChatGPT
OPENAI_API_KEY=

# Claude
ANTHROPIC_API_KEY=

# Gemini (o código lê GOOGLE_API_KEY, não GEMINI_API_KEY)
GOOGLE_API_KEY=

# Grok (xAI)
XAI_API_KEY=
